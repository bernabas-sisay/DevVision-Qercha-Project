# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://qercha:qercha@localhost:5432/qercha
DIRECT_URL=postgresql://qercha:qercha@localhost:5432/qercha

# Cache & Queues (Valkey / Redis)
REDIS_URL=redis://localhost:6379

# Authentication & Security Secrets
JWT_SECRET=your_jwt_secret_must_be_random_and_long
PIN_SECRET=your_pin_secret_must_be_random_and_long

# Telegram Bot & Webhook
BOT_TOKEN=123456:your_bot_token_from_botfather
WEBHOOK_SECRET=your_random_webhook_secret
MINI_APP_URL=https://staging.yourdomain.com
BOT_USERNAME=QerchaStagingBot
APP_SHORT_NAME=app

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Payment Verification (Sponsor Integration)
VERIFIER_MODE=mock
VERIFIER_URL=https://verifier.example.com
VERIFIER_KEY=your_sponsor_verifier_key
QERCHA_ACCOUNTS=[{"bank":"CBE","account":"1000123456789"},{"bank":"BOA","account":"987654321"}]

# Feature Flags & Test Controls
DELIVERY_CODE_REQUIRED=true
ENABLE_TEST_ROUTES=true

# Database Seeding
SEED_ADMIN_TELEGRAM_ID=123456789

# Frontend / Vite Configuration
VITE_BOT_USERNAME=QerchaStagingBot
VITE_APP_SHORT_NAME=app
VITE_DEV_INIT_DATA=
